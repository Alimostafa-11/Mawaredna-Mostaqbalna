# Environment for the docker-compose stack.
#
# Copy to `.env` in this same directory — Compose reads it automatically — and
# override only what differs from local development. Every value here has a
# working local default in docker-compose.yml, so an empty or missing .env
# gives you the normal `docker compose up` stack.
#
#   cp .env.example .env
#
# NOTE: `$` in a value must be written `$$`, or Compose treats it as a
# variable reference. Watch for this in database passwords.

# =============================================================================
# Deploying to a real host? These four are the ones that break the site.
# =============================================================================
#
# NEXT_PUBLIC_* are compiled into the browser bundle at BUILD time. Changing
# them requires rebuilding the web image:
#
#   docker compose up -d --build web
#
# A plain restart keeps the old values baked in.

# What the browser calls for the public contact form and the calculator.
# Leaving this as localhost means those forms fail for every real visitor.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where gallery media is served from. A bare hostname is assumed to be https
# (cdn.example.com); give a full origin when the scheme or port differ. Wrong
# value = next/image answers 400 and every uploaded photo renders blank.
NEXT_PUBLIC_MEDIA_HOST=http://minio.localhost:9000

# The origin(s) the API accepts browser calls from, comma-separated. This
# defaults to http://localhost:3000, which is what produces a CORS error
# naming localhost once the site is on a real domain.
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Secrets — change all of these before exposing the stack to anyone
# =============================================================================

# At least 32 characters. Rotating it signs everyone out.
JWT_SECRET=local-development-secret-change-me-please-32
JWT_EXPIRES_IN=7d

# Only read by `npm run seed`; the seeded admin account keeps working after
# you remove them.
ADMIN_EMAIL=admin@mawaredna.com
ADMIN_PASSWORD=ChangeMe123!

# Serves Swagger at /api/docs. Turn this off on anything public.
ENABLE_SWAGGER=true

# =============================================================================
# Database
# =============================================================================

# Default points at the `mongo` service in this stack. Swap in Atlas or
# DocumentDB to run the database outside compose; DocumentDB additionally
# needs `retryWrites=false`.
MONGODB_URI=mongodb://root:example@mongo:27017/agri?authSource=admin

# =============================================================================
# Object storage
# =============================================================================
#
# The defaults wire the stack to the bundled MinIO. To use a real S3 bucket,
# clear S3_ENDPOINT and S3_PUBLIC_ENDPOINT — they exist only to point at a
# S3-compatible server — and set S3_FORCE_PATH_STYLE=false.
#
# The browser PUTs uploads straight to the bucket, so a real bucket also needs
# a CORS rule allowing PUT from your site's origin. See docs/DEPLOYMENT.md.

AWS_REGION=eu-central-1
S3_BUCKET=mawaredna-media
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://minio.localhost:9000
S3_PUBLIC_URL=http://minio.localhost:9000/mawaredna-media
S3_FORCE_PATH_STYLE=true

# On AWS with an instance or task role, leave both of these EMPTY so the SDK
# picks the role up instead.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# =============================================================================
# Worked example: compose stack on one server at https://mawaredna.com
# =============================================================================
#
# Put a reverse proxy (Caddy, nginx, Traefik) in front, terminating TLS and
# forwarding to the two published ports. Give the API its own hostname —
# never route mawaredna.com/api/* to it, because the web app serves
# /api/auth/* and /api/admin/* itself and the dashboard depends on them.
#
#   NEXT_PUBLIC_API_URL=https://api.mawaredna.com/api/v1
#   NEXT_PUBLIC_SITE_URL=https://mawaredna.com
#   NEXT_PUBLIC_MEDIA_HOST=https://media.mawaredna.com
#   CORS_ORIGINS=https://mawaredna.com
#   API_URL=http://api:4000/api/v1          # stays internal, not the domain
#   S3_PUBLIC_ENDPOINT=https://media.mawaredna.com
#   S3_PUBLIC_URL=https://media.mawaredna.com/mawaredna-media
#   JWT_SECRET=<openssl rand -base64 48>
#   ENABLE_SWAGGER=false
