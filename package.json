{
  "name": "mawaredna-mostaqbalna",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Mawaredna Mostaqbalna - agricultural waste recycling & compost production",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @agri/api",
    "dev:web": "npm run dev -w @agri/web",
    "build": "npm run build -w @agri/api && npm run build -w @agri/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "npm run seed -w @agri/api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "lucide-react": "^1.46.0",
    "next-intl": "^4.14.5",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3"
  }
}
