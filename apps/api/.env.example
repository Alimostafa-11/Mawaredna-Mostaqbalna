# ---- Runtime ----
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Serves Swagger UI at /{API_PREFIX}/docs. Unset follows NODE_ENV (on outside
# production). Keep it off, or behind auth, on a public production API.
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000

# ---- Database ----
# Host access to the docker-compose Mongo (published on 27018 to avoid
# clashing with a Mongo you may already run on 27017):
MONGODB_URI=mongodb://root:example@localhost:27018/agri?authSource=admin
# AWS DocumentDB example:
# MONGODB_URI=mongodb://user:pass@docdb-cluster.cluster-xxxx.eu-central-1.docdb.amazonaws.com:27017/agri?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# ---- Auth (admin panel / protected write endpoints) ----
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
# Seeded on `npm run seed`
ADMIN_EMAIL=admin@mawaredna.com
ADMIN_PASSWORD=ChangeMe123!

# ---- AWS S3 (media storage) ----
AWS_REGION=eu-central-1
S3_BUCKET=mawaredna-media
# Leave the two below EMPTY in AWS (ECS/App Runner/EC2) so the SDK uses the IAM task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN in front of the bucket, e.g. https://cdn.mawaredna.com
S3_PUBLIC_URL=
# S3-compatible endpoint for local dev. To use the MinIO service from
# docker-compose, set all four of these:
#   S3_ENDPOINT=http://localhost:9000
#   S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---- Rate limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=60
