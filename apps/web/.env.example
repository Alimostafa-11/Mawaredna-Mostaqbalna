# Base URL of the NestJS API, used by server components and route handlers.
API_URL=http://localhost:4000/api/v1

# Same API, as seen by the browser (client-side form posts).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where gallery media is served from. Must be set for next/image to accept it.
# Either a bare hostname (assumed https), e.g. cdn.mawaredna.com or the S3
# bucket host, or a full origin when the port or scheme differ - the local
# docker-compose MinIO is http://localhost:9000
NEXT_PUBLIC_MEDIA_HOST=
