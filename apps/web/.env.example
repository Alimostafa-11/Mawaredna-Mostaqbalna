# Base URL of the NestJS API, used by server components and route handlers.
API_URL=http://localhost:4000/api/v1

# Same API, as seen by the browser (client-side form posts).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostname serving media (CloudFront distribution or the S3 bucket host).
# Must be set for next/image to accept remote media.
NEXT_PUBLIC_MEDIA_HOST=
